{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-25",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "homepage5",
	"workers_dev": false,
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
	},
	"observability": {
		"enabled": true,
	},
	"preview_urls": true,
	// on-demand のページを Cloudflare に返させる。期間は各ページのヘッダーで決まり、
	// ヘッダーが無い 200 は 2 時間キャッシュされるので、Worker の応答には必ず付ける。
	"cache": {
		"enabled": true,
	},
}
