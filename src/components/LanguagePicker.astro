---
import { getRelativeLocaleUrl } from "astro:i18n";
import Check from "../assets/check.svg";
import ExpandMore from "../assets/expand-more.svg";
import Globe from "../assets/language.svg";
import { langs, localeNames, type Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

interface Props {
	id: string;
	lang: Lang;
	path: string;
}

const { id, lang, path } = Astro.props;
const t = useTranslations(lang);

const mutedLink =
	"text-ink-muted hover:text-accent focus-visible:outline-accent rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2";
const item = "flex items-center gap-2 px-3 py-2";
---

<nav aria-label={t("nav.language")}>
	<details id={id} class="group relative">
		<summary class:list={[mutedLink, "cursor-pointer list-none py-1"]}>
			<span class="inline-flex items-center gap-2 align-middle">
				<Globe
					class="block h-4 w-auto"
					fill="currentColor"
					aria-hidden="true"
				/>
				<span lang={lang}>{localeNames[lang]}</span>
				<span class="sr-only">{t("nav.languageSwitch")}</span>
				<ExpandMore
					class="block h-4 w-auto group-open:rotate-180"
					fill="currentColor"
					aria-hidden="true"
				/>
			</span>
		</summary>

		<ul
			class="border-line bg-surface-raised absolute top-full right-0 z-10 mt-1 w-max rounded-xs border py-1"
		>
			{
				langs.map((locale) => (
					<li>
						{locale === lang ? (
							<span
								aria-current="page"
								lang={locale}
								class:list={["text-ink", item]}
							>
								<Check
									class="block h-4 w-auto"
									fill="currentColor"
									aria-hidden="true"
								/>
								{localeNames[locale]}
							</span>
						) : (
							<a
								href={getRelativeLocaleUrl(locale, path)}
								hreflang={locale}
								lang={locale}
								class:list={[mutedLink, item]}
							>
								<Check class="invisible block h-4 w-auto" aria-hidden="true" />
								{localeNames[locale]}
							</a>
						)}
					</li>
				))
			}
		</ul>
	</details>
</nav>
