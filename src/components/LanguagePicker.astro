---
import { getRelativeLocaleUrl } from "astro:i18n";
import { langs, localeNames, type Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

interface Props {
	lang: Lang;
	path: string;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);
---

<nav aria-label={t("nav.language")}>
	<ul class="flex gap-3 px-4 py-2">
		{
			langs.map((locale) => (
				<li lang={locale}>
					{locale === lang ? (
						<span aria-current="true">{localeNames[locale]}</span>
					) : (
						<a href={getRelativeLocaleUrl(locale, path)} hreflang={locale}>
							{localeNames[locale]}
						</a>
					)}
				</li>
			))
		}
	</ul>
</nav>
