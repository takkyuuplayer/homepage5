---
import { getRelativeLocaleUrl } from "astro:i18n";
import { defaultLang, localeNames, type Lang } from "../i18n/ui";
import { getPathWithoutLocale, isLang, useTranslations } from "../i18n/utils";

const lang = isLang(Astro.currentLocale) ? Astro.currentLocale : defaultLang;
const t = useTranslations(lang);

const path = getPathWithoutLocale(Astro.url.pathname);
const locales = Object.keys(localeNames) as Lang[];
---

<nav aria-label={t("nav.language")}>
	<ul>
		{
			locales.map((locale) => (
				<li lang={locale}>
					{locale === lang ? (
						<span aria-current="true">{localeNames[locale]}</span>
					) : (
						<a href={getRelativeLocaleUrl(locale, path)} hreflang={locale}>
							{localeNames[locale]}
						</a>
					)}
				</li>
			))
		}
	</ul>
</nav>

<style>
	ul {
		display: flex;
		gap: 0.75rem;
		list-style: none;
		margin: 0;
		padding: 0.5rem 1rem;
	}
</style>
