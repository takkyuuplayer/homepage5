---
import { getRelativeLocaleUrl } from "astro:i18n";
import Logo from "../assets/logo.svg";
import LanguagePicker from "./LanguagePicker.astro";
import type { UIKey } from "../i18n/ui";
import {
	getPathWithoutLocale,
	resolveLang,
	useTranslations,
} from "../i18n/utils";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);

const path = getPathWithoutLocale(Astro.url.pathname);

const items: { key: UIKey; path: string }[] = [
	{ key: "nav.apps", path: "apps" },
	{ key: "nav.math", path: "math" },
	{ key: "nav.blog", path: "blog" },
	{ key: "nav.about", path: "about" },
];
---

<header class="border-line h-16 border-b">
	<div class="container-page flex h-full items-center justify-between gap-4">
		<a
			href={getRelativeLocaleUrl(lang, "")}
			aria-label={t("nav.home")}
			class="focus-visible:outline-accent rounded-xs focus-visible:outline-2 focus-visible:outline-offset-4"
		>
			<Logo class="text-ink block h-8 w-auto" aria-hidden="true" />
		</a>

		<div class="flex items-center gap-4">
			<nav aria-label={t("nav.main")}>
				<button
					type="button"
					popovertarget="site-nav"
					aria-label={t("nav.menu")}
					class="focus-visible:outline-accent rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 sm:hidden"
				>
					<svg
						aria-hidden="true"
						viewBox="0 0 24 24"
						class="block h-6 w-6"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
					>
						<line x1="3" y1="6" x2="21" y2="6"></line>
						<line x1="3" y1="12" x2="21" y2="12"></line>
						<line x1="3" y1="18" x2="21" y2="18"></line>
					</svg>
				</button>

				<ul
					id="site-nav"
					popover
					class="border-line bg-surface-raised text-ink top-16 right-0 bottom-auto left-0 m-0 w-auto gap-4 border-b p-4 open:flex open:flex-col sm:static sm:flex sm:flex-row sm:gap-6 sm:border-0 sm:bg-transparent sm:p-0"
				>
					{
						items.map((item) => (
							<li>
								<a
									href={getRelativeLocaleUrl(lang, item.path)}
									aria-current={item.path === path ? "page" : undefined}
									class:list={[
										"focus-visible:outline-accent hover:text-accent rounded-xs focus-visible:outline-2 focus-visible:outline-offset-4",
										item.path === path ? "text-ink" : "text-ink-muted",
									]}
								>
									{t(item.key)}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<LanguagePicker lang={lang} path={path} />
		</div>
	</div>
</header>
