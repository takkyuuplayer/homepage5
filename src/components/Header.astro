---
import { getRelativeLocaleUrl } from "astro:i18n";
import Logo from "../assets/logo.svg";
import NavLinks from "./NavLinks.astro";
import { resolveLang, useTranslations } from "../i18n/utils";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<header class="border-line h-16 border-b">
	<div class="container-page flex h-full items-center justify-between gap-4">
		<a
			href={getRelativeLocaleUrl(lang, "")}
			aria-label={t("nav.home")}
			class="focus-visible:outline-accent rounded-xs focus-visible:outline-2 focus-visible:outline-offset-4"
		>
			<Logo class="text-ink block h-8 w-auto" aria-hidden="true" />
		</a>

		<nav aria-label={t("nav.main")}>
			<button
				type="button"
				popovertarget="site-nav"
				aria-label={t("nav.menu")}
				class="focus-visible:outline-accent rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 sm:hidden"
			>
				<svg
					aria-hidden="true"
					viewBox="0 0 24 24"
					class="block h-6 w-6"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
				>
					<line x1="3" y1="6" x2="21" y2="6"></line>
					<line x1="3" y1="12" x2="21" y2="12"></line>
					<line x1="3" y1="18" x2="21" y2="18"></line>
				</svg>
			</button>

			<!-- sm 未満はハンバーガーの下に開くパネル、sm 以上は同じ項目を横一列に常に出す。
			     同じ項目を 2 回描くが、見えているのは常に片方で、display: none の方は
			     アクセシビリティツリーにも出ない。popover を両方の幅で使い回すと、UA の
			     popover スタイルを sm: で戻す指定と、広げたときに閉じる JS が要る。 -->
			<div id="site-nav" popover>
				<NavLinks layout="column" />
			</div>

			<div class="flex items-center gap-4 max-sm:hidden">
				<NavLinks layout="row" />
			</div>
		</nav>
	</div>
</header>

<style>
	@reference "../styles/global.css";

	/* popover は top layer で position: fixed になり、UA が inset: 0 を当てるので、
	   それを戻して呼び出しボタンの下に右揃えで置く。popovertarget で開いた popover は
	   ボタンを implicit anchor として持つため、anchor-name / position-anchor は書かない。
	   margin・border・padding は Preflight が 0 にしているので、ここで付け直す。 */
	[popover] {
		position-area: bottom span-left;
		inset: auto;
		margin: --spacing(1) 0 0;
		width: max-content;
		border: 1px solid var(--color-line);
		border-radius: var(--radius-xs);
		background-color: var(--color-surface-raised);
		padding: --spacing(1) 0;

		&:popover-open {
			display: flex;
			flex-direction: column;
		}

		/* 開いたまま sm 以上に広げても閉じる JS は持たず、表示だけ消す。
		   狭めれば開いたまま戻り、外側クリックや Esc で閉じる。 */
		@variant sm {
			&:popover-open {
				display: none;
			}
		}
	}
</style>
