---
import { getRelativeLocaleUrl } from "astro:i18n";
import Check from "../assets/check.svg";
import Logo from "../assets/logo.svg";
import { langs, localeNames, type UIKey } from "../i18n/ui";
import {
	getPathWithoutLocale,
	resolveLang,
	useTranslations,
} from "../i18n/utils";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);

const path = getPathWithoutLocale(Astro.url.pathname);

const items: { key: UIKey; path: string }[] = [
	{ key: "nav.apps", path: "apps" },
	{ key: "nav.math", path: "math" },
	{ key: "nav.blog", path: "blog" },
	{ key: "nav.welcome", path: "welcome" },
];

// ページのリンクと言語のリンクで同じ形。今いる場所は aria-current で示し、色もそれに
// 連動させる。今の言語は href の無い a（リンクの置き場所を示すプレースホルダー）なので、
// hover の色は href のあるものだけに付ける。sm 未満はパネルの中なので左右に余白を取る。
const itemClass =
	"text-ink-muted aria-[current=page]:text-ink [&[href]:hover]:text-accent focus-visible:outline-accent flex items-center gap-2 rounded-xs py-2 focus-visible:outline-2 focus-visible:outline-offset-2 max-sm:px-3";
---

<header class="border-line h-16 border-b">
	<div class="container-page flex h-full items-center justify-between gap-4">
		<a
			href={getRelativeLocaleUrl(lang, "")}
			aria-label={t("nav.home")}
			class="focus-visible:outline-accent rounded-xs focus-visible:outline-2 focus-visible:outline-offset-4"
		>
			<Logo class="text-ink block h-8 w-auto" aria-hidden="true" />
		</a>

		<nav aria-label={t("nav.main")}>
			<button
				type="button"
				popovertarget="site-nav"
				aria-label={t("nav.menu")}
				class="focus-visible:outline-accent rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 sm:hidden"
			>
				<svg
					aria-hidden="true"
					viewBox="0 0 24 24"
					class="block h-6 w-6"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
				>
					<line x1="3" y1="6" x2="21" y2="6"></line>
					<line x1="3" y1="12" x2="21" y2="12"></line>
					<line x1="3" y1="18" x2="21" y2="18"></line>
				</svg>
			</button>

			<!-- ページと言語を 1 つのパネルにまとめ、区切り線で分ける。sm 未満はハンバーガーの
			     下に開く小さなパネル。sm 以上は閉じたまま横一列に見せるため、UA が popover に
			     当てる display: none・position: fixed・overflow: auto・背景を sm: で戻す
			     （margin・border・padding は Preflight が 0 にしているので戻さない）。 -->
			<div
				id="site-nav"
				popover
				class="max-sm:menu-panel open:flex open:flex-col sm:static sm:flex sm:flex-row sm:items-center sm:gap-4 sm:overflow-visible sm:bg-transparent"
			>
				<ul class="sm:flex sm:gap-6">
					{
						items.map((item) => (
							<li>
								<a
									href={getRelativeLocaleUrl(lang, item.path)}
									aria-current={item.path === path ? "page" : undefined}
									class={itemClass}
								>
									{t(item.key)}
								</a>
							</li>
						))
					}
				</ul>

				<hr class="border-line max-sm:my-1 sm:h-5 sm:border-t-0 sm:border-l" />

				<ul aria-label={t("nav.language")} class="sm:flex sm:gap-4">
					{
						langs.map((locale) => {
							const current = locale === lang;
							return (
								<li>
									<a
										href={
											current ? undefined : getRelativeLocaleUrl(locale, path)
										}
										hreflang={current ? undefined : locale}
										aria-current={current ? "page" : undefined}
										lang={locale}
										class={itemClass}
									>
										{/* 今の言語だけチェック。他は sm 未満の縦並びで文字の左端を揃えるための透明な印 */}
										<Check
											class:list={[
												"h-4 w-auto",
												!current && "invisible sm:hidden",
											]}
											fill="currentColor"
											aria-hidden="true"
										/>
										{localeNames[locale]}
									</a>
								</li>
							);
						})
					}
				</ul>
			</div>
		</nav>
	</div>
</header>

<script>
	// popover は top layer にいる間、著者スタイルでは position を静的に戻せない
	// （CSS Position 4: specified position が absolute/fixed 以外なら absolute に computes する）。
	// sm: でハンバーガーが隠れると閉じる手段も消えるため、隠れた時点で閉じる。
	// hidePopover() は閉じている popover には何もしないので、開閉状態は見ていない。
	const nav = document.getElementById("site-nav");
	const button = document.querySelector('[popovertarget="site-nav"]');

	addEventListener("resize", () => {
		if (!button?.checkVisibility()) nav?.hidePopover();
	});
</script>
