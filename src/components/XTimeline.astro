---
import { resolveLang, useTranslations } from "../i18n/utils";

interface Props {
	screenName: string;
}

const { screenName } = Astro.props;

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<!--
  widgets.js は href から screen name を読み取り、この a 要素を
  syndication.twitter.com の iframe に差し替える。差し替えが起きなかった場合は
  このリンクがそのまま残るため、フォールバックを別に用意する必要はない。
  href は x.com ではなく twitter.com のままにしている（差し替えを確認できたのが
  この形だけのため）。
-->
<a
	class="twitter-timeline focus-visible:outline-accent hover:text-accent rounded-xs hover:underline focus-visible:outline-2 focus-visible:outline-offset-2"
	data-theme="dark"
	data-chrome="noheader nofooter transparent"
	data-dnt="true"
	data-lang={lang}
	data-height="600"
	href={`https://twitter.com/${screenName}`}
>
	{t("top.timelineFallback")}
</a>

<!--
  CDN のスクリプトは Astro のバンドル対象から外す必要がある。
  integrity は付けない。X はバージョンを持たない URL を配信し続けており、
  ハッシュを固定すると更新のたびにウィジェットが読み込まれなくなる。
-->
<script
	is:inline
	async
	src="https://platform.twitter.com/widgets.js"
	charset="utf-8"></script>
