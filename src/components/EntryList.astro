---
import ExternalLink from "./ExternalLink.astro";
import { resolveLang } from "../i18n/utils";
import { formatDate, toDateString } from "../lib/date";
import type { ListEntry } from "../lib/entries";

interface Props {
	items: readonly ListEntry[];
}

const { items } = Astro.props;

const lang = resolveLang(Astro.currentLocale);
---

<ul class="space-y-2">
	{
		items.map((item) => (
			<li class="flex gap-4">
				<time
					datetime={toDateString(item.publishedAt)}
					class="text-ink-muted shrink-0 tabular-nums"
				>
					{formatDate(item.publishedAt, lang)}
				</time>
				{item.url ? (
					<ExternalLink href={item.url}>{item.title}</ExternalLink>
				) : (
					<span>{item.title}</span>
				)}
			</li>
		))
	}
</ul>
