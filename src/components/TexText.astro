---
import { parseTex, renderMath } from "../lib/tex";

interface Props {
	// LaTeX。数式は $…$ / $$…$$ / align*、段落は改行文字で区切る。
	tex: string;
	class?: string;
}

const { tex, class: className } = Astro.props;

// text 断片は Astro のエスケープを通し、set:html を使うのは Temml が出した MathML
// だけに限る。display の数式を <p> に入れて overflow-x を付けると overflow-y も
// auto になり、行ボックスと <math> の高さのずれで縦のスクロールバーが出るため、
// 単独の div を横スクロールの入れ物にする。
// テンプレート側の HTML コメントは出力に残り、問題ごとに繰り返されるのでここに書く。
const blocks = parseTex(tex);
---

{
	blocks.map((block) =>
		block.kind === "display" ? (
			<div
				class:list={[className, "overflow-x-auto overflow-y-hidden"]}
				set:html={renderMath(block.value, true)}
			/>
		) : (
			<p class={className}>
				{block.segments.map((segment) =>
					segment.kind === "math" ? (
						<Fragment set:html={renderMath(segment.value, false)} />
					) : (
						segment.value
					),
				)}
			</p>
		),
	)
}
