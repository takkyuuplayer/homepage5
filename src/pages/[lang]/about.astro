---
import ExternalLink from "../../components/ExternalLink.astro";
import { hosts } from "../../data/hosting";
import { resolveLang, useTranslations } from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";

export { getLangStaticPaths as getStaticPaths } from "../../i18n/utils";

const t = useTranslations(resolveLang(Astro.currentLocale));

function closedIn(year: number): string {
	return t("service.closedIn").replace("{year}", String(year));
}
---

<Layout title={t("nav.about")} description={t("about.description")}>
	<h1 class="page-heading">{t("nav.about")}</h1>

	<div class="mt-8 space-y-4">
		<p>{t("about.beforeHosts")}</p>
		<!-- 段落 1 の途中で移転履歴に入り、段落 2 で文に戻る構造は移植元のまま。
		     移植元は a → a → a と横に並べていたが、名前・アイコン・終了年が並ぶと
		     区切りが追いにくいので 1 行 1 件にし、移転の順番は ol の番号で示す。 -->
		<ol
			aria-label={t("about.hosts")}
			class="bg-surface-raised list-inside list-decimal space-y-1 rounded-md px-4 py-3"
		>
			{
				hosts.map((host) => (
					<li>
						{host.closed ? (
							<>
								<ExternalLink href={host.closed.url}>{host.name}</ExternalLink>
								<span class="text-ink-muted">{closedIn(host.closed.year)}</span>
							</>
						) : (
							<ExternalLink href={host.url}>{host.name}</ExternalLink>
						)}
					</li>
				))
			}
		</ol>
		<p>{t("about.afterHosts")}</p>
		<p>{t("about.closing")}</p>
	</div>
</Layout>
