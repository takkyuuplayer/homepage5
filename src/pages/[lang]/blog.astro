---
import EntryList from "../../components/EntryList.astro";
import ExternalLink from "../../components/ExternalLink.astro";
import { blogs, hasFeed } from "../../data/blogs";
import { isLang, useTranslations } from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";
import { fetchEntries } from "../../lib/feed";

// 記事一覧を新しい投稿に追従させるため、リクエスト時に描画する。
export const prerender = false;

// Workers Cache とブラウザで 5 分キャッシュし、その間はフィードを取りに行かない。
// 期間は public/_headers の静的ページと揃える。
const cacheControl = "public, max-age=300";

// getStaticPaths が使われないので、/fr/blog のような URL もここに来る。
// ja に寄せると存在しない URL が 200 で増えるため 404 にする。
const lang = Astro.params.lang;
if (!isLang(lang)) {
	return new Response(null, {
		status: 404,
		headers: { "Cache-Control": cacheControl },
	});
}
const t = useTranslations(lang);

Astro.response.headers.set("Cache-Control", cacheControl);

const posts = await fetchEntries();

// 移植元のナビにあった「現在 ~ 2014」のような表記は正確でなくなっていたため、
// フィードの記事日付で確認した年を出す。同じ年で始まり終わるものは 1 つにする。
function period(from: number, to: number): string {
	return from === to ? `${from}` : `${from}–${to}`;
}
---

<Layout title={t("nav.blog")} description={t("blog.description")}>
	<h1 class="page-heading">{t("nav.blog")}</h1>

	<div class="mt-8 space-y-12">
		<section>
			<p>{t("blog.lead")}</p>
			<ul class="mt-4 space-y-2">
				{blogs.map((blog) => (
					<li class="flex flex-wrap gap-x-4">
						{hasFeed(blog) ? (
							<>
								<span class="text-ink-muted shrink-0 tabular-nums">
									{period(blog.from, blog.to)}
								</span>
								<ExternalLink href={blog.url}>{blog.name[lang]}</ExternalLink>
							</>
						) : (
							<span>
								{blog.name[lang]}
								<span class="text-ink-muted">{t("service.closed")}</span>
							</span>
						)}
						{blog.note && <span class="text-ink-muted">{blog.note[lang]}</span>}
					</li>
				))}
			</ul>
		</section>

		<section>
			<h2 class="section-heading">{t("blog.posts")}</h2>
			{posts.length > 0 ? (
				<EntryList items={posts} />
			) : (
				<p class="text-ink-muted">{t("top.postsUnavailable")}</p>
			)}
		</section>
	</div>
</Layout>
