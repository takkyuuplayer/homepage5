---
import { getRelativeLocaleUrl } from "astro:i18n";
import EntryList from "../../components/EntryList.astro";
import { historyEntries } from "../../data/history";
import { resolveLang, useTranslations } from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";
import { fetchEntries } from "../../lib/feed";

export { getLangStaticPaths as getStaticPaths } from "../../i18n/utils";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);

// prerender が既定なのでビルド時に一度だけ走る。リクエスト時に取りたくなったら
// このページに export const prerender = false を足す。
const posts = (await fetchEntries()).slice(0, 5);

// 全 76 件を常に並べるとフッターが遠くなるため、続きは details に入れる。
// 履歴は日本語のみなので、英語ページでも同じ内容を出す（見出しに注記あり）。
const recentHistory = historyEntries.slice(0, 10);
const olderHistory = historyEntries.slice(10);
---

<Layout>
	<!-- ロゴは aria-hidden の SVG で、包む a は「ホーム」とラベルされている。
	     サイト名をアクセシビリティツリーに出すのはこの h1 だけ。 -->
	<h1 class="sr-only">{t("site.title")}</h1>

	<div class="mt-8 space-y-12">
		<section>
			<h2 class="section-heading">{t("top.latestPosts")}</h2>
			{
				posts.length > 0 ? (
					<EntryList items={posts} />
				) : (
					<p class="text-ink-muted">{t("top.postsUnavailable")}</p>
				)
			}
			<a
				href={getRelativeLocaleUrl(lang, "blog")}
				class="link mt-4 inline-block"
			>
				{t("top.allPosts")}
			</a>
		</section>

		<section>
			<h2 class="section-heading">{t("top.history")}</h2>
			<EntryList items={recentHistory} />
			<details class="mt-2">
				<summary
					class="focus-visible:outline-accent hover:text-accent w-fit cursor-pointer rounded-xs py-2 focus-visible:outline-2 focus-visible:outline-offset-2"
				>
					{t("top.olderHistory")}
				</summary>
				<EntryList items={olderHistory} />
			</details>
		</section>
	</div>
</Layout>
