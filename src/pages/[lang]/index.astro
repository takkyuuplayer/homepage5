---
import { getRelativeLocaleUrl } from "astro:i18n";
import EntryList from "../../components/EntryList.astro";
import XTimeline from "../../components/XTimeline.astro";
import { historyEntries } from "../../data/history";
import { resolveLang, useTranslations } from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";
import { fetchEntries } from "../../lib/feed";

export { getLangStaticPaths as getStaticPaths } from "../../i18n/utils";

const lang = resolveLang(Astro.currentLocale);
const t = useTranslations(lang);

// prerender が既定なのでビルド時に一度だけ走る。リクエスト時に取りたくなったら
// このページに export const prerender = false を足す。
const posts = (await fetchEntries()).slice(0, 5);

// 全 76 件を常に並べるとフッターが遠くなるため、続きは details に入れる。
// 履歴は日本語のみなので、英語ページでも同じ内容を出す（見出しに注記あり）。
const history = historyEntries();
const recentHistory = history.slice(0, 10);
const olderHistory = history.slice(10);

const heading = "border-line mb-4 border-b pb-2 text-lg font-bold";
---

<Layout>
	<h1 class="mt-8 text-2xl font-bold">{t("site.title")}</h1>

	<div class="mt-8 grid gap-12 lg:grid-cols-3">
		<div class="space-y-12 lg:col-span-2">
			<section>
				<h2 class={heading}>{t("top.latestPosts")}</h2>
				{
					posts.length > 0 ? (
						<EntryList items={posts} />
					) : (
						<p class="text-ink-muted">{t("top.postsUnavailable")}</p>
					)
				}
				<a
					href={getRelativeLocaleUrl(lang, "blog")}
					class="focus-visible:outline-accent hover:text-accent mt-4 inline-block rounded-xs hover:underline focus-visible:outline-2 focus-visible:outline-offset-2"
				>
					{t("top.allPosts")}
				</a>
			</section>

			<section>
				<h2 class={heading}>{t("top.history")}</h2>
				<EntryList items={recentHistory} />
				<details class="mt-2">
					<summary
						class="focus-visible:outline-accent hover:text-accent w-fit cursor-pointer rounded-xs py-2 focus-visible:outline-2 focus-visible:outline-offset-2"
					>
						{t("top.olderHistory")}
					</summary>
					<EntryList items={olderHistory} />
				</details>
			</section>
		</div>

		<aside>
			<h2 class={heading}>{t("top.timeline")}</h2>
			<XTimeline screenName="takkyuuplayer" />
		</aside>
	</div>
</Layout>
